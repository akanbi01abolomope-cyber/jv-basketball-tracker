rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /teams/{teamId} {
      allow read, write: if teamId == 'jv-basketball-tracker'
        && request.auth != null
        && request.auth.token.email in [
          'YOUR_EMAIL@example.com',
          'COACH_EMAIL@example.com'
        ];
    }
  }
}
